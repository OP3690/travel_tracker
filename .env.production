# react-snap requirement: CRA inlines runtime JS into index.html by default
# for one-less-request wins, but that inlined script references webpack hash
# names react-snap cannot see when it hydrates a snapshot. Forcing the
# runtime into a separate file keeps hydration deterministic.
INLINE_RUNTIME_CHUNK=false

# Keep source maps off in production — they balloon the deploy and leak
# component names, and Lighthouse never asks for them anyway.
GENERATE_SOURCEMAP=false
