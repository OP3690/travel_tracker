# Copy to .env and fill in values. Never commit the real .env.

# ============================================================
# EMAIL — pick ONE provider
# ============================================================

# Preferred: Resend (HTTPS API). Required on DigitalOcean droplets —
# DO blocks outbound SMTP ports (25/465/587) by default, so no SMTP
# provider works there without a support ticket. Resend uses HTTPS
# so it just works. Free tier: 3,000 emails/mo.
# Get the key at https://resend.com/api-keys
RESEND_API_KEY=                     # re_... (highest priority if set)

# Visible From: on every email. Must be a Resend-verified domain
# (add DNS records at resend.com/domains) or onboarding@resend.dev
# for the sandbox (only sends to the Resend account owner).
EMAIL_FROM=support@stampyourmap.com
EMAIL_FROM_NAME=StampYourMap

# Fallback: SMTP via nodemailer. Used only when RESEND_API_KEY is empty.
# Works from any host where outbound SMTP isn't blocked.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=support@stampyourmap.com
SMTP_PASS=                          # app password (16 chars for Gmail)

# ============================================================
# OTHER
# ============================================================

APP_URL=https://stampyourmap.com

# Dev mode: redirect ALL outbound mail to this address for review.
# Leave empty in production to send to real recipients.
EMAIL_REDIRECT_TO=

# Expose GET /api/auth/email-debug?key=<this>&to=<addr> for a
# full one-shot SMTP/Resend test from curl. Pick any random string.
EMAIL_DEBUG_KEY=
